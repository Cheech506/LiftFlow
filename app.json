{
  "expo": {
    "name": "LiftFlow",
    "slug": "liftflow",
    "version": "0.5.1",
    "orientation": "portrait",
    "scheme": "liftflow",
    "userInterfaceStyle": "dark",
    "icon": "./assets/liftflow-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cheech.liftflow"
    },
    "android": {
      "package": "com.cheech.liftflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/liftflow-foreground.png",
        "backgroundColor": "#0D1210"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/liftflow-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
